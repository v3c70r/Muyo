# CMake package configuration for `muyo_rg` (#73).
#
# This file is generated from `cmake/muyo_rgConfig.cmake.in` by
# `configure_package_config_file()` and installed next to `muyo_rgTargets.cmake` and
# `muyo_rgConfigVersion.cmake`, so a consumer only needs
#
#     find_package(muyo_rg 0.1 REQUIRED)
#     target_link_libraries(app PRIVATE Muyo::muyo_rg)
#
# `muyo_rg` ships its own copy of VMA and SPIRV-Reflect as exported targets, so Vulkan is the one
# dependency that has to be present on the consumer's machine. It is looked up here, at configure
# time, rather than left to fail later at the consumer's compile or link step: the error names Vulkan
# because this is the call that failed.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The device layer is Vulkan-only (`docs/RenderGraph-Library-Design.md` section 2), so a missing SDK
# is the expected external failure. `find_dependency` forwards REQUIRED and turns a miss into
# `muyo_rg_FOUND = FALSE` with a message naming Vulkan, which is what the out-of-tree probe checks.
find_dependency(Vulkan REQUIRED)

# `Vulkan::Vulkan` was added to FindVulkan in CMake 3.17, and this project's stated minimum is 3.11.
# A consumer on an older CMake still has the legacy `Vulkan_LIBRARIES` / `Vulkan_INCLUDE_DIR`
# variables, so give the exported `Muyo::muyo_device` the imported target it names. FindVulkan itself
# only defines the target when it is absent, so the shim cannot shadow a newer FindVulkan.
if(NOT TARGET Vulkan::Vulkan)
    add_library(Vulkan::Vulkan INTERFACE IMPORTED)
    target_link_libraries(Vulkan::Vulkan INTERFACE "${Vulkan_LIBRARIES}")
    if(Vulkan_INCLUDE_DIR)
        target_include_directories(Vulkan::Vulkan INTERFACE "${Vulkan_INCLUDE_DIR}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/muyo_rgTargets.cmake")

check_required_components(muyo_rg)
