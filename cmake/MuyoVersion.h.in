#pragma once

/// @file
/// Compile-time version of the `muyo_rg` RenderGraph library.
///
/// **Generated** by CMake from `cmake/MuyoVersion.h.in` using the version declared by
/// `project(Muyo VERSION ...)`; do not edit the copy in the build tree. Include
/// `RenderGraph/MuyoVersion.h` for the Doxygen-documented constants, or this header directly when a
/// preprocessor comparison is what is needed.
///
/// The components use Vulkan's layout, so the combined integer is comparable across versions:
/// `#if MUYO_RG_VERSION >= MUYO_RG_MAKE_VERSION(0, 1, 0, 0)`.

/// Major component of the library version.
#define MUYO_RG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// Minor component of the library version.
#define MUYO_RG_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// Patch component of the library version.
#define MUYO_RG_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// Variant component: 0 for this library's own version line. Matches `VK_API_VERSION_VARIANT`.
#define MUYO_RG_VERSION_VARIANT 0

/// Compose a version integer from its components.
///
/// The layout matches Vulkan's `VK_MAKE_API_VERSION`: variant in the top three bits, major in the
/// next seven, minor in the next ten and patch in the low twelve. The arguments are deliberately not
/// cast, unlike Vulkan's macro, so the result is a preprocessor integer constant and can be used in
/// `#if`:
///
/// @code
/// #if MUYO_RG_VERSION >= MUYO_RG_MAKE_VERSION(0, 1, 0, 0)
/// ...
/// #endif
/// @endcode
#define MUYO_RG_MAKE_VERSION(variant, major, minor, patch) \
    (((variant) << 29) | ((major) << 22) | ((minor) << 12) | (patch))

/// The library version as one comparable integer.
#define MUYO_RG_VERSION \
    MUYO_RG_MAKE_VERSION(MUYO_RG_VERSION_VARIANT, MUYO_RG_VERSION_MAJOR, MUYO_RG_VERSION_MINOR, MUYO_RG_VERSION_PATCH)

/// The library version as a `"major.minor.patch"` string literal.
#define MUYO_RG_VERSION_STRING "@PROJECT_VERSION@"
